# Discord Webhook URL
# DiscordサーバーのチャンネルSettings → Integrations → Webhooks で取得
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# J-Quants API（任意。無くても yfinance だけで動く）
# 推奨: メール＋パスワード。リフレッシュトークンを毎回自動発行するので失効しない。
JQUANTS_MAIL_ADDRESS=
JQUANTS_PASSWORD=
# 非推奨: 手動発行のリフレッシュトークン（1週間で失効する）
JQUANTS_REFRESH_TOKEN=
